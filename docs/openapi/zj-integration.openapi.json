                "properties": {
                  "external_reference": {
                    "type": "string"
                  },
                  "replayed": {
                    "type": "boolean"
                  },
                  "instance_id": {
                    "type": "integer"
                  },
                  "serial": {
                    "type": "integer"
                  },
                  "status": {
                    "type": "string"
                  },
                  "process": {
                    "type": "object"
                  },
                  "current_step": {
                    "$ref": "#/components/schemas/ProcessStep"
                  },
                  "third_party": {
                    "type": "object"
                  },
                  "responsible": {
