{
  "openapi": "3.1.0",
  "info": {
    "title": "SGA360 - API de integración Z&J",
    "version": "1.1.0",
    "summary": "Integración empresarial para consultar terceros, procesos y órdenes de cliente.",
    "description": "API máquina-a-máquina para los desarrollos externos de Z&J. El cliente obtiene un JWT con vigencia de 3 horas, verifica disponibilidad mediante el handshake, consulta catálogos internos y crea instancias y órdenes de cliente de forma idempotente.\n\n## Flujo recomendado\n\n1. Obtener un JWT en `POST /auth/token`.\n2. Ejecutar `GET /handshake`.\n3. Consultar o buscar terceros, servicios y procesos.\n4. Crear una instancia de proceso.\n5. Crear la orden de cliente asociada.\n\nEl `company_id` y el usuario técnico provienen siempre del JWT. Nunca deben enviarse en el body, query string ni parámetros de ruta.",
    "contact": {
      "name": "SGA360"
    }
  },
  "servers": [
    {
      "url": "/api/integrations/v1",
      "description": "Servidor actual"
    }
  ],
  "tags": [
    {
      "name": "Autenticación",
      "description": "Emisión de tokens JWT temporales."
    },
    {
      "name": "Conectividad",
      "description": "Verificación de autenticación y disponibilidad."
    },
    {
      "name": "Terceros",
      "description": "Clientes disponibles para la compañía autenticada."
    },
    {
      "name": "Servicios",
      "description": "Servicios activos que pueden incluirse en órdenes."
    },
    {
      "name": "Procesos",
      "description": "Procesos, etapas e instancias."
    },
    {
      "name": "Órdenes de cliente",
      "description": "Creación idempotente de documentos Client Order."
    }
  ],
  "paths": {
    "/auth/token": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Obtener token de acceso",
        "description": "Intercambia `client_id` y `client_secret` por un JWT con duración de 3 horas. El secreto solamente debe enviarse a este endpoint.",
        "operationId": "issueIntegrationToken",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              },
              "example": {
                "client_id": "zj-orders-production",
                "client_secret": "CONFIGURE_EL_SECRETO_LOCALMENTE"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token emitido correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidClient"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          }
        }
      }
    },
    "/handshake": {
      "get": {
        "tags": ["Conectividad"],
        "summary": "Verificar conexión y disponibilidad",
        "description": "Valida JWT, credencial, base de datos, compañía y usuario técnico.",
        "operationId": "integrationHandshake",
        "responses": {
          "200": {
            "description": "Integración disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandshakeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/third-parties": {
      "get": {
        "tags": ["Terceros"],
        "summary": "Listar terceros disponibles",
        "description": "Devuelve por defecto terceros activos de tipo `client` y `both` pertenecientes a la compañía del JWT.",
        "operationId": "listThirdParties",
        "parameters": [
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "name": "type",
            "in": "query",
            "description": "Uno o varios tipos separados por coma.",
            "schema": {
              "type": "string",
              "example": "client,both"
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Listado paginado.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ThirdParty"
                          }
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/third-parties/search": {
      "get": {
        "tags": ["Terceros"],
        "summary": "Buscar terceros",
        "description": "Busca clientes activos de la compañía autenticada.\n\n## Cómo usar los parámetros\n\nTodos los parámetros son opcionales individualmente, pero la petición debe conservar **al menos uno** de estos filtros: `names`, `lastNames`, `corporative_name`, `email` o `nit`. Para cambiar la búsqueda, agregue o quite parámetros del query string. Si envía varios filtros, el tercero debe cumplirlos todos.\n\n- `names`, `lastNames` y `corporative_name`: coincidencia parcial, sin distinguir mayúsculas.\n- `email`: coincidencia exacta, sin distinguir mayúsculas.\n- `nit`: coincidencia exacta; puede enviarse con o sin puntos y guiones.\n- `type`, `page` y `limit`: parámetros adicionales opcionales.\n\n### Ejemplos rápidos\n\nSolo razón social: `?corporative_name=Z%26J`\n\nSolo NIT: `?nit=900.123.456-7`\n\nNombre y apellido: `?names=Juan&lastNames=Pérez`\n\nNombre con opciones: `?names=Juan&type=client,both&page=1&limit=20`\n\nPara personas jurídicas, `corporative_name` consulta el campo interno `names`. Una petición sin ninguno de los cinco filtros de identidad responde con HTTP `400`.",
        "operationId": "searchThirdParties",
        "x-codeSamples": [
          {
            "lang": "Shell",
            "label": "Solo razón social",
            "source": "curl --get \\\n  'http://localhost:3000/api/integrations/v1/third-parties/search' \\\n  --header 'Authorization: Bearer <jwt>' \\\n  --data-urlencode 'corporative_name=Z&J'"
          },
          {
            "lang": "Shell",
            "label": "Solo correo",
            "source": "curl --get \\\n  'http://localhost:3000/api/integrations/v1/third-parties/search' \\\n  --header 'Authorization: Bearer <jwt>' \\\n  --data-urlencode 'email=cliente@empresa.com'"
          },
          {
            "lang": "Shell",
            "label": "Solo NIT",
            "source": "curl --get \\\n  'http://localhost:3000/api/integrations/v1/third-parties/search' \\\n  --header 'Authorization: Bearer <jwt>' \\\n  --data-urlencode 'nit=900.123.456-7'"
          },
          {
            "lang": "Shell",
            "label": "Combinar y quitar parámetros",
            "source": "curl --get \\\n  'http://localhost:3000/api/integrations/v1/third-parties/search' \\\n  --header 'Authorization: Bearer <jwt>' \\\n  --data-urlencode 'names=Juan' \\\n  --data-urlencode 'lastNames=Pérez' \\\n  --data-urlencode 'type=client,both' \\\n  --data-urlencode 'page=1' \\\n  --data-urlencode 'limit=20'\n\n# Para ampliar la búsqueda, quite por ejemplo esta línea:\n#   --data-urlencode 'lastNames=Pérez'\n# Debe dejar al menos names, lastNames, corporative_name, email o nit."
          }
        ],
        "parameters": [
          {
            "name": "names",
            "in": "query",
            "description": "Nombre o fragmento del nombre.",
            "schema": { "type": "string", "maxLength": 200 },
            "example": "Juan"
          },
          {
            "name": "lastNames",
            "in": "query",
            "description": "Apellido o fragmento del apellido.",
            "schema": { "type": "string", "maxLength": 200 },
            "example": "Pérez"
          },
          {
            "name": "corporative_name",
            "in": "query",
            "description": "Razón social o fragmento de ella.",
            "schema": { "type": "string", "maxLength": 200 },
            "example": "Z&J"
          },
          {
            "name": "email",
            "in": "query",
            "description": "Correo electrónico exacto, sin distinguir mayúsculas.",
            "schema": { "type": "string", "format": "email", "maxLength": 200 },
            "example": "cliente@empresa.com"
          },
          {
            "name": "nit",
            "in": "query",
            "description": "NIT o número de identificación exacto. Se ignoran separadores como puntos y guiones.",
            "schema": { "type": "string", "maxLength": 200 },
            "example": "900.123.456-7"
          },
          {
            "name": "type",
            "in": "query",
            "description": "Uno o varios tipos separados por coma. Por defecto: client,both.",
            "schema": { "type": "string", "example": "client,both" }
          },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Coincidencias paginadas.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/ThirdParty" }
                        },
                        "pagination": { "$ref": "#/components/schemas/Pagination" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/third-parties/{id}": {
      "get": {
        "tags": ["Terceros"],
        "summary": "Consultar tercero por ID",
        "operationId": "getThirdPartyById",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del tercero.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ThirdParty"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/services": {
      "get": {
        "tags": ["Servicios"],
        "summary": "Listar servicios activos",
        "description": "No expone costos internos. Los IDs devueltos se utilizan en `items[].service_id` al crear una orden.",
        "operationId": "listServices",
        "parameters": [
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Listado paginado de servicios.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Service"
                          }
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/processes": {
      "get": {
        "tags": ["Procesos"],
        "summary": "Listar procesos disponibles",
        "description": "Incluye las etapas ordenadas de cada proceso activo.",
        "operationId": "listProcesses",
        "responses": {
          "200": {
            "description": "Procesos disponibles.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Process"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/process-instances/{id}": {
      "get": {
        "tags": ["Procesos"],
        "summary": "Consultar instancia de proceso",
        "operationId": "getProcessInstanceById",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la instancia.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ProcessInstance"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/process-instances": {
      "post": {
        "tags": ["Procesos"],
        "summary": "Crear instancia de proceso",
        "description": "Crea solamente la instancia. La compañía y el responsable salen del JWT; la primera etapa se obtiene de la configuración del proceso. La operación es idempotente por `external_reference`.",
        "operationId": "createProcessInstance",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProcessInstanceRequest"
              },
              "example": {
                "external_reference": "WA-PROCESS-84521",
                "process_id": 1,
                "thirdParty_id": 93,
                "start_date": "2026-07-30T14:15:00-05:00",
                "delivery_date": "2026-07-31T18:00:00-05:00",
                "description": "Pedido recibido mediante WhatsApp",
                "metadata": {
                  "source": "whatsapp",
                  "conversation_id": "573001234567"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Instancia creada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateProcessInstanceResponse"
                }
              }
            }
          },
          "200": {
            "description": "Referencia repetida con el mismo contenido. Se devuelve la instancia existente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateProcessInstanceResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/customer-orders": {
      "post": {
        "tags": ["Órdenes de cliente"],
        "summary": "Crear orden de cliente",
        "description": "Crea el documento `Client Order`, lo relaciona con la instancia y registra sus movimientos de servicios en una sola transacción. El tercero y la etapa se derivan de la instancia. Los totales se calculan en el backend.",
        "operationId": "createCustomerOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomerOrderRequest"
              },
              "example": {
                "external_reference": "WA-ORDER-84521",
                "instance_id": 4705,
                "store_id": 1,
                "description": "Orden recibida mediante WhatsApp",
                "items": [
                  {
                    "service_id": 166,
                    "units": 2,
                    "unit_value": "1250.50",
                    "description": "Línea promocionales"
                  },
                  {
                    "service_id": 171,
                    "units": 3,
                    "unit_value": "2000.25",
                    "description": "Línea impresión"
                  }
                ],
                "metadata": {
                  "source": "whatsapp",
                  "conversation_id": "573001234567"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Orden creada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCustomerOrderResponse"
                }
              }
            }
          },
          "200": {
            "description": "Referencia repetida con el mismo contenido. Se devuelve la orden existente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCustomerOrderResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT obtenido mediante `POST /auth/token`."
      }
    },
    "parameters": {
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "Search": {
        "name": "search",
        "in": "query",
        "description": "Texto de búsqueda.",
        "schema": {
          "type": "string",
          "maxLength": 200
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "La petición no cumple el contrato.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InvalidClient": {
        "description": "Client ID o client secret inválido.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "INVALID_CLIENT",
                "message": "Credenciales inválidas."
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "JWT ausente, inválido o vencido.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "INVALID_ACCESS_TOKEN",
                "message": "Token de acceso inválido o vencido."
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "La credencial no posee el scope requerido.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "INSUFFICIENT_SCOPE",
                "message": "La integración no tiene permisos para esta operación."
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "El recurso no existe dentro de la compañía autenticada.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "La referencia externa ya existe con información diferente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "EXTERNAL_REFERENCE_CONFLICT",
                "message": "La referencia ya existe con información diferente."
              }
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Los IDs existen en el contrato, pero no están disponibles para esta operación.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimitExceeded": {
        "description": "Se superó el límite de solicitudes de autenticación.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Algún componente necesario no está disponible.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_id", "client_secret"],
        "properties": {
          "client_id": {
            "type": "string",
            "example": "zj-orders-production"
          },
          "client_secret": {
            "type": "string",
            "format": "password",
            "minLength": 32,
            "writeOnly": true
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": ["access_token", "token_type", "expires_in", "scope"],
        "properties": {
          "access_token": {
            "type": "string",
            "format": "password"
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "example": 10800
          },
          "scope": {
            "type": "string"
          }
        }
      },
      "HandshakeResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessResponse"
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "available"
              },
              "service": {
                "type": "string",
                "example": "sga360-integrations"
              },
              "version": {
                "type": "string",
                "example": "v1"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "checks": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "integration": {
                "type": "object",
                "properties": {
                  "client_id": {
                    "type": "string"
                  },
                  "company_id": {
                    "type": "integer"
                  },
                  "company_name": {
                    "type": "string"
                  },
                  "service_user_id": {
                    "type": ["integer", "null"]
                  },
                  "service_user_name": {
                    "type": ["string", "null"]
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "Pagination": {
        "type": "object",
        "required": ["page", "limit", "total", "total_pages"],
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          }
        }
      },
      "ThirdParty": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "names": {
            "type": "string"
          },
          "lastNames": {
            "type": "string"
          },
          "corporative_name": {
            "type": ["string", "null"],
            "description": "Razón social cuando el registro representa una persona jurídica."
          },
          "full_name": {
            "type": "string"
          },
          "indentification_type": {
            "type": "string"
          },
          "indentification_number": {
            "type": "string"
          },
          "mail": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": ["string", "null"]
          },
          "city": {
            "type": ["string", "null"]
          },
          "address": {
            "type": ["string", "null"]
          },
          "type": {
            "type": "string",
            "enum": ["client", "supplier", "employee", "contractor", "partner", "other", "both"]
          }
        }
      },
      "Service": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "units": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "img": {
            "type": ["string", "null"]
          },
          "taxed": {
            "type": "boolean"
          },
          "tax_id": {
            "type": ["integer", "null"]
          },
          "type": {
            "type": "string",
            "const": "service"
          },
          "status": {
            "type": "string",
            "const": "active"
          }
        }
      },
      "ProcessStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "order": {
            "type": "integer"
          },
          "optional": {
            "type": "boolean"
          },
          "end_process": {
            "type": "boolean"
          }
        }
      },
      "Process": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "img": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string",
            "const": "active"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProcessStep"
            }
          }
        }
      },
      "ProcessInstance": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "serial": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "start_date": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "delivery_date": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "process": {
            "type": "object"
          },
          "current_step": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProcessStep"
              },
              {
                "type": "null"
              }
            ]
          },
          "third_party": {
            "type": ["object", "null"]
          },
          "responsible": {
            "type": ["object", "null"]
          }
        }
      },
      "CreateProcessInstanceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["external_reference", "process_id", "thirdParty_id", "delivery_date"],
        "properties": {
