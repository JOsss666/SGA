      "CreateCustomerOrderRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["external_reference", "instance_id", "store_id", "items"],
        "properties": {
          "external_reference": {
            "$ref": "#/components/schemas/ExternalReference"
          },
          "instance_id": {
            "type": "integer",
            "minimum": 1
          },
          "store_id": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/CustomerOrderItemRequest"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "CustomerOrderItemRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_id", "units", "unit_value"],
        "properties": {
          "service_id": {
            "type": "integer",
            "minimum": 1
          },
          "units": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "unit_value": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,6})?$",
            "description": "Valor monetario positivo con máximo 6 decimales."
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "CreateCustomerOrderResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SuccessResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "external_reference": {
                    "type": "string"
                  },
                  "replayed": {
                    "type": "boolean"
                  },
                  "document_id": {
                    "type": "integer"
                  },
                  "serial": {
                    "type": "integer"
                  },
                  "status": {
                    "type": "string"
                  },
                  "subtotal": {
                    "type": "string"
                  },
                  "total": {
                    "type": "string"
                  },
                  "instance_id": {
                    "type": "integer"
                  },
                  "process_instance": {
                    "type": "object"
                  },
                  "third_party": {
                    "type": "object"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "ExternalReference": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
        "description": "Identificador idempotente generado por el sistema externo."
      }
    }
