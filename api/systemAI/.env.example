SYSTEM_AI_ENABLED=false
SYSTEM_AI_PROVIDER=openrouter
SYSTEM_AI_DEFAULT_MODEL=openai/gpt-4.1-mini
SYSTEM_AI_MAX_INPUT_CHARACTERS=12000
SYSTEM_AI_MAX_OUTPUT_TOKENS=6000
SYSTEM_AI_REQUEST_TIMEOUT_MS=60000
SYSTEM_AI_REQUESTS_PER_MINUTE=20
SYSTEM_AI_MAX_COST_PER_RUN=0.10

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=SGA360

# Sesiones de usuarios del ERP
SESSION_COOKIE_NAME=__Host-sga_session
SESSION_IDLE_TIMEOUT_MINUTES=45
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
SESSION_TOUCH_INTERVAL_MINUTES=5
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-characters
SESSION_SECURE_COOKIE=true
# Usar none cuando el frontend y la API están en sitios distintos; requiere HTTPS.
SESSION_COOKIE_SAME_SITE=none
# Solo durante una transición controlada. En producción se recomienda false.
SESSION_TRUST_LEGACY_COMPANY_BODY=false
