# PostgreSQL
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=5432

# Firma de JWT para integraciones empresariales.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTEGRATION_JWT_SECRET=
INTEGRATION_JWT_ISSUER=sga360
INTEGRATION_JWT_AUDIENCE=sga360-integrations

# Sesiones HttpOnly para usuarios del ERP.
# Generar el pepper con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_TOKEN_PEPPER=
SESSION_COOKIE_NAME=__Host-sga_session
SESSION_IDLE_TIMEOUT_MINUTES=45
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
SESSION_TOUCH_INTERVAL_MINUTES=5
SESSION_SECURE_COOKIE=true
# La API alojada en onrender.com y los frontends sga360.co son cross-site.
SESSION_COOKIE_SAME_SITE=none
SESSION_TRUST_LEGACY_COMPANY_BODY=false
